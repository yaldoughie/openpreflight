{
  "name": "openpreflight/openpreflight",
  "description": "Development dependencies for the OpenPreflight Agent WordPress plugin.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpstan/phpstan": "2.2.5",
    "phpunit/phpunit": "10.5.64",
    "szepeviktor/phpstan-wordpress": "2.0.3",
    "wp-coding-standards/wpcs": "3.4.0",
    "dealerdirect/phpcodesniffer-composer-installer": "1.2.1"
  },
  "autoload": {
    "psr-4": {
      "OpenPreflight\\Agent\\": "wordpress-plugin/openpreflight-agent/includes/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "lint": "phpcs",
    "phpstan": "phpstan analyse",
    "test": "phpunit",
    "check": [
      "@lint",
      "@phpstan",
      "@test"
    ]
  }
}
