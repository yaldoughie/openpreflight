# Copy to .env. Values below are development-only and contain no credentials.
OPENPREFLIGHT_CONFIG=openpreflight.config.yaml
OPENPREFLIGHT_LOG_LEVEL=info
# Required only when binding the API beyond loopback:
# OPENPREFLIGHT_API_TOKEN=
# Optional alternative to the generated local credential-encryption key:
# OPENPREFLIGHT_ENCRYPTION_KEY=
