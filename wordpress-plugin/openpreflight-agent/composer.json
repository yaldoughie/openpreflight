{
  "name": "openpreflight/agent",
  "description": "Runtime autoloader for the OpenPreflight Agent plugin.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "autoload": {
    "psr-4": {
      "OpenPreflight\\Agent\\": "includes/"
    }
  },
  "config": {
    "classmap-authoritative": true,
    "sort-packages": true
  }
}
