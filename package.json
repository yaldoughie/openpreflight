{
  "name": "openpreflight",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "openpreflight": "tsx apps/cli/src/index.ts",
    "dev": "pnpm --parallel --filter @openpreflight/server --filter @openpreflight/dashboard dev",
    "build": "tsx scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "integration": "vitest run --config vitest.integration.config.ts",
    "e2e": "tsx scripts/build.ts && playwright test",
    "demo": "tsx scripts/demo.ts",
    "doctor": "tsx apps/cli/src/index.ts doctor",
    "package": "tsx scripts/package.ts",
    "docs": "tsx scripts/check-docs.ts",
    "clean": "tsx scripts/clean.ts",
    "schemas:validate": "tsx scripts/validate-schemas.ts",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@changesets/cli": "2.31.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/archiver": "8.0.0",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/tar-stream": "3.1.4",
    "@types/unzipper": "0.10.11",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.7.0",
    "esbuild": "0.28.1",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10",
    "yaml": "2.9.0",
    "archiver": "8.0.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "nanoid": "6.0.0"
  }
}
